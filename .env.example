# Existing
OPENAI_API_KEY=

# Server-only HMAC secret for Practice Mode Show Solution tokens.
# Generate a long random value (32+ characters). Never prefix with NEXT_PUBLIC_.
# Example: openssl rand -hex 32
PRACTICE_TOKEN_SECRET=

# Supabase (required for accounts + cloud progress + logged-in daily limits)
# Project URL: Integrations → Data API (or project Connect dialog)
# Publishable key: Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy fallback only (old anon JWT). Prefer PUBLISHABLE_KEY above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Do NOT put the Secret key (sb_secret_...) or service_role key in NEXT_PUBLIC_ vars.
# This app does not require a Secret key for the Free-plan design.
