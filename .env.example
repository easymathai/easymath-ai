# Existing
OPENAI_API_KEY=

# Server-only HMAC secret for Practice Mode Show Solution tokens.
# Generate a long random value (32+ characters). Never prefix with NEXT_PUBLIC_.
# Example: openssl rand -hex 32
PRACTICE_TOKEN_SECRET=

# Server-only secret for guest solver cookies and guest usage RPCs.
# Separate from PRACTICE_TOKEN_SECRET. Never prefix with NEXT_PUBLIC_.
# Example: openssl rand -hex 32
# Store only the SHA-256 hash of this value in Supabase (see supabase/add_guest_solver_usage.sql).
GUEST_USAGE_SECRET=

# Supabase (required for accounts + cloud progress + logged-in daily limits)
# Project URL: Integrations → Data API (or project Connect dialog)
# Publishable key: Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy fallback only (old anon JWT). Prefer PUBLISHABLE_KEY above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Do NOT put the Secret key (sb_secret_...) or legacy service_role key in NEXT_PUBLIC_ vars.
# Guest solver usage uses the public key plus GUEST_USAGE_SECRET-gated RPCs.
# Free-plan limits and guest usage do not need the Secret key.
#
# Server-only Supabase Secret key — required for Account → Delete account.
# Supabase Dashboard → Project Settings → API Keys → Secret key (sb_secret_...).
# Never prefix with NEXT_PUBLIC_. Leave empty in this file; set the real value
# in .env.local and in Vercel Environment Variables.
SUPABASE_SECRET_KEY=

# Optional legacy fallback only (old service_role JWT). Prefer SUPABASE_SECRET_KEY above.
SUPABASE_SERVICE_ROLE_KEY=

# Public support email shown on /support, /privacy, and /terms.
# Optional override. If unset, the app uses easymathai2026@gmail.com.
NEXT_PUBLIC_SUPPORT_EMAIL=easymathai2026@gmail.com
